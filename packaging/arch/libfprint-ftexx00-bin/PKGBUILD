# Maintainer: FTEXX00 Linux driver contributors

pkgname=libfprint-ftexx00-bin
pkgver=1.94.4_20250112
pkgrel=1
pkgdesc="Binary libfprint backend for FocalTech FTEXX00 SPI readers"
arch=('x86_64')
url="https://github.com/oneXfive/ubuntu_spi"
license=('custom:unknown')
groups=('fprint')
options=('!strip' '!debug')
depends=('gcc-libs' 'glib2' 'glibc' 'libgudev' 'libgusb' 'nss' 'pixman'
         'focaltech-ftexx00-dkms')
makedepends=('binutils')
provides=('libfprint=1.94.100' 'libfprint-2.so')
conflicts=('libfprint')
_deb="libfprint-2-2_1.94.4+tod1-0ubuntu1~22.04.2_spi_20250112_amd64.deb"
source=("$_deb::https://raw.githubusercontent.com/oneXfive/ubuntu_spi/main/$_deb")
sha256sums=('b48c93c3732f90aabbcc520e5538faeffbb87bb6847a01d03e14ea157f1d36c1')

prepare() {
  cd "$srcdir"
  ar x "$_deb"
  bsdtar -xf data.tar.*
}

package() {
  install -Dm755 \
    "$srcdir/usr/lib/x86_64-linux-gnu/libfprint-2.so.2.0.0" \
    "$pkgdir/usr/lib/libfprint-2.so.2.0.0"
  ln -s libfprint-2.so.2.0.0 "$pkgdir/usr/lib/libfprint-2.so.2"
  ln -s libfprint-2.so.2.0.0 "$pkgdir/usr/lib/libfprint-2.so"

  install -Dm644 "$srcdir/usr/share/doc/libfprint-2-2/copyright" \
    "$pkgdir/usr/share/licenses/$pkgname/copyright"

  install -dm755 \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d"
  printf '%s\n' \
    '[Service]' \
    'DeviceAllow=/dev/focal_moh_spi rw' \
    > "$pkgdir/usr/lib/systemd/system/fprintd.service.d/focaltech-spi.conf"
}
